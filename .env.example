# Copy to .env for local use. Never commit real values.
# Child name, birth date, timezone, and caregiver allowlist live in config.json
# (start from config.example.json). Do not put family names or emails here.

FAMILY_PIN=
SESSION_SECRET=
DATA_DIR=./data
CONFIG_PATH=./config.json
# Optional: override config.json timezone (IANA name, e.g. America/Chicago)
APP_TIMEZONE=
